<script>


/* ==========================================================
   DATA
========================================================== */

const tourism = ',
tourism_json,
';



/* ==========================================================
   SVG SETUP
========================================================== */

const svg =
    d3.select("#pacific-map");


const wrapper =
    document.querySelector(".map-wrapper");


const tooltip =
    d3.select("#tooltip");


const width =
    wrapper.clientWidth;


const height =
    700;


svg

    .attr(
        "viewBox",
        `0 0 ${width} ${height}`
    )

    .attr(
        "preserveAspectRatio",
        "xMidYMid meet"
    );



/* ==========================================================
   PACIFIC-CENTERED PROJECTION
========================================================== */

const projection =

    d3.geoNaturalEarth1()


        /* Put Pacific in the center */

        .rotate([
            -170,
            0
        ])


        /* Move focal point slightly south */

        .center([
            0,
            -5
        ])


        /* ==================================================
           ZOOM

           Original version = 0.255

           Current version = 0.32

           Increase to 0.34 if you want even more zoom.
        ================================================== */

        .scale(
            width * 0.45
        )


        .translate([
            width / 2,
            height / 2 + 25
        ]);



const path =
    d3.geoPath(
        projection
    );



/* ==========================================================
   SPHERE / OCEAN
========================================================== */

svg

    .append("path")

    .datum({
        type: "Sphere"
    })

    .attr(
        "class",
        "sphere"
    )

    .attr(
        "d",
        path
    );



/* ==========================================================
   GRATICULE
========================================================== */

svg

    .append("path")

    .datum(
        d3.geoGraticule10()
    )

    .attr(
        "class",
        "graticule"
    )

    .attr(
        "d",
        path
    );



/* ==========================================================
   PACIFIC TEXT
========================================================== */

svg

    .append("text")

    .attr(
        "class",
        "ocean-title"
    )

    .attr(
        "x",
        width / 2
    )

    .attr(
        "y",
        height / 2 + 15
    )

    .attr(
        "text-anchor",
        "middle"
    )

    .text(
        "PACIFIC"
    );



/* ==========================================================
   MAP LAYERS

   Layer order matters:

   labels
   ↑
   tourism bubbles
   ↑
   geographic aura
   ↑
   basemap

========================================================== */

const mapLayer =
    svg.append("g");


const auraLayer =
    svg.append("g");


const bubbleLayer =
    svg.append("g");


const labelLayer =
    svg.append("g");



/* ==========================================================
   TOURISM BUBBLE SCALE
========================================================== */

const radius =

    d3.scaleSqrt()

        .domain([

            0,

            d3.max(
                tourism,
                d => +d.Value
            )

        ])

        .range([
            5,
            44
        ]);



/* ==========================================================
   LOAD WORLD MAP
========================================================== */

d3.json(

    "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json"

)

.then(

    world => {


        const countries =

            topojson.feature(

                world,

                world.objects.countries

            );



        /* --------------------------------------------------
           COASTLINE GLOW
        -------------------------------------------------- */

        mapLayer

            .append("path")

            .datum(
                countries
            )

            .attr(
                "class",
                "coast-glow"
            )

            .attr(
                "d",
                path
            );



        /* --------------------------------------------------
           LAND
        -------------------------------------------------- */

        mapLayer

            .selectAll(".land")

            .data(
                countries.features
            )

            .enter()

            .append("path")

            .attr(
                "class",
                "land"
            )

            .attr(
                "d",
                path
            );



        drawTourism();

    }

)

.catch(

    error => {


        console.error(

            "World map failed to load:",

            error

        );


        drawTourism();

    }

);



/* ==========================================================
   DRAW TOURISM DATA
========================================================== */

function drawTourism() {



    /* ======================================================
       PROJECT COUNTRY COORDINATES
    ====================================================== */

    tourism.forEach(

        d => {


            const coords =

                projection([

                    +d.Longitude,

                    +d.Latitude

                ]);


            d.x =
                coords[0];


            d.y =
                coords[1];

        }

    );



    /* ======================================================
       GEOGRAPHIC AURA
    ======================================================

       IMPORTANT:

       The aura does NOT represent tourism magnitude.

       Tourism magnitude = bubble size.

       Aura simply emphasizes the geographic location and
       creates the visual language that will later be reused
       for climate variables.

    ====================================================== */


    const auraOuter =
        62;


    const auraMiddle =
        45;


    const auraInner =
        30;



    /* ------------------------------------------------------
       OUTER AURA
    ------------------------------------------------------ */

    auraLayer

        .selectAll(".aura-outer")

        .data(
            tourism
        )

        .enter()

        .append("circle")

        .attr(
            "class",
            "aura-outer"
        )

        .attr(
            "cx",
            d => d.x
        )

        .attr(
            "cy",
            d => d.y
        )

        .attr(
            "r",
            auraOuter
        );



    /* ------------------------------------------------------
       MIDDLE AURA
    ------------------------------------------------------ */

    auraLayer

        .selectAll(".aura-middle")

        .data(
            tourism
        )

        .enter()

        .append("circle")

        .attr(
            "class",
            "aura-middle"
        )

        .attr(
            "cx",
            d => d.x
        )

        .attr(
            "cy",
            d => d.y
        )

        .attr(
            "r",
            auraMiddle
        );



    /* ------------------------------------------------------
       INNER AURA
    ------------------------------------------------------ */

    auraLayer

        .selectAll(".aura-inner")

        .data(
            tourism
        )

        .enter()

        .append("circle")

        .attr(
            "class",
            "aura-inner"
        )

        .attr(
            "cx",
            d => d.x
        )

        .attr(
            "cy",
            d => d.y
        )

        .attr(
            "r",
            auraInner
        );



    /* ======================================================
       PULSE RINGS

       Only large tourism-dependent economies.
    ====================================================== */

    const pulseData =

        tourism.filter(

            d =>
                +d.Value >= 18

        );



    const pulse =

        bubbleLayer

            .selectAll(".pulse-ring")

            .data(
                pulseData
            )

            .enter()

            .append("circle")

            .attr(
                "class",
                "pulse-ring"
            )

            .attr(
                "cx",
                d => d.x
            )

            .attr(
                "cy",
                d => d.y
            )

            .attr(
                "r",
                d =>
                    radius(+d.Value)
            );



    function animatePulse() {


        pulse

            .attr(
                "r",
                d =>
                    radius(+d.Value)
            )

            .attr(
                "opacity",
                0.38
            )

            .transition()

            .duration(
                2500
            )

            .ease(
                d3.easeCubicOut
            )

            .attr(
                "r",
                d =>
                    radius(+d.Value)
                    +
                    18
            )

            .attr(
                "opacity",
                0
            )

            .on(
                "end",
                animatePulse
            );

    }


    animatePulse();



    /* ======================================================
       MAIN TOURISM BUBBLES
    ====================================================== */

    const bubbles =

        bubbleLayer

            .selectAll(".bubble")

            .data(
                tourism
            )

            .enter()

            .append("circle")

            .attr(
                "class",
                "bubble bubble-world"
            )

            .attr(
                "cx",
                d => d.x
            )

            .attr(
                "cy",
                d => d.y
            )

            .attr(
                "r",
                d =>
                    radius(+d.Value)
            )

            .attr(
                "fill-opacity",
                0.82
            )



            /* ----------------------------------------------
               HOVER
            ---------------------------------------------- */

            .on(

                "mouseenter",

                function(event, d) {


                    d3.select(this)

                        .transition()

                        .duration(
                            160
                        )

                        .attr(
                            "r",
                            radius(+d.Value)
                            *
                            1.12
                        );



                    tooltip

                        .style(
                            "opacity",
                            1
                        )

                        .html(
                            `

                            <div class="tooltip-country">

                                ${d.Flag} ${d.Country}

                            </div>


                            <div class="tooltip-stat">

                                Tourism contribution:

                                <span class="tooltip-value">

                                    ${(+d.Value).toFixed(2)}%

                                </span>

                            </div>


                            <div class="tooltip-source">

                                Source: ${d.Source}

                            </div>

                            `
                        );

                }

            )



            .on(

                "mousemove",

                function(event) {


                    const box =

                        wrapper
                            .getBoundingClientRect();



                    tooltip

                        .style(

                            "left",

                            (

                                event.clientX
                                -
                                box.left
                                +
                                15

                            )

                            +

                            "px"

                        )

                        .style(

                            "top",

                            (

                                event.clientY
                                -
                                box.top
                                +
                                15

                            )

                            +

                            "px"

                        );

                }

            )



            .on(

                "mouseleave",

                function(event, d) {


                    d3.select(this)

                        .transition()

                        .duration(
                            160
                        )

                        .attr(

                            "r",

                            radius(+d.Value)

                        );


                    tooltip

                        .style(
                            "opacity",
                            0
                        );

                }

            );



    /* ======================================================
       BUBBLE LIGHT REFLECTION
    ====================================================== */

    bubbleLayer

        .selectAll(".inner-bubble")

        .data(
            tourism
        )

        .enter()

        .append("circle")

        .attr(
            "class",
            "inner-bubble"
        )

        .attr(

            "cx",

            d =>
                d.x
                -
                radius(+d.Value)
                *
                0.20

        )

        .attr(

            "cy",

            d =>
                d.y
                -
                radius(+d.Value)
                *
                0.20

        )

        .attr(

            "r",

            d =>
                Math.max(

                    3,

                    radius(+d.Value)
                    *
                    0.22

                )

        );



    /* ======================================================
       LEADER LINES
    ====================================================== */

    labelLayer

        .selectAll(".leader-line")

        .data(
            tourism
        )

        .enter()

        .append("line")

        .attr(
            "class",
            "leader-line"
        )

        .attr(
            "x1",
            d => d.x
        )

        .attr(
            "y1",
            d => d.y
        )

        .attr(

            "x2",

            d =>
                d.x
                +
                +d.dx

        )

        .attr(

            "y2",

            d =>
                d.y
                +
                +d.dy

        );



    /* ======================================================
       COUNTRY + FLAG LABEL
    ====================================================== */

    labelLayer

        .selectAll(".country-label")

        .data(
            tourism
        )

        .enter()

        .append("text")

        .attr(
            "class",
            "country-label"
        )

        .attr(

            "x",

            d =>
                d.x
                +
                +d.dx

        )

        .attr(

            "y",

            d =>
                d.y
                +
                +d.dy

        )

        .attr(

            "text-anchor",

            d =>
                +d.dx < 0

                ?

                "end"

                :

                "start"

        )

        .text(

            d =>
                `${d.Flag} ${d.Country}`

        );



    /* ======================================================
       TOURISM VALUE
    ====================================================== */

    labelLayer

        .selectAll(".value-label")

        .data(
            tourism
        )

        .enter()

        .append("text")

        .attr(
            "class",
            "value-label"
        )

        .attr(

            "x",

            d =>
                d.x
                +
                +d.dx

        )

        .attr(

            "y",

            d =>
                d.y
                +
                +d.dy
                +
                16

        )

        .attr(

            "text-anchor",

            d =>
                +d.dx < 0

                ?

                "end"

                :

                "start"

        )

        .text(

            d =>
                `${(+d.Value).toFixed(1)}%`

        );

}


</script>


</body>

</html>

')


