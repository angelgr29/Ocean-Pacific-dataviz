<script>


/* ==========================================================
   DATA FROM PYTHON
========================================================== */

const attractions =
    __ATTRACTIONS_JSON__;



/* ==========================================================
   SVG
========================================================== */

const svg =
    d3.select("#pacific-map");


const wrapper =
    document.querySelector(".map-wrapper");


const width =
    wrapper.clientWidth;


const height =
    780;


svg

    .attr(
        "viewBox",
        `0 0 ${width} ${height}`
    )

    .attr(
        "preserveAspectRatio",
        "xMidYMid meet"
    );



/* ==========================================================
   PACIFIC PROJECTION
========================================================== */

const projection =

    d3.geoNaturalEarth1()

        .rotate([
            -170,
            0
        ])

        .center([
            0,
            -3
        ])

        .scale(
            width * 0.5
        )

        .translate([
            width / 2,
            height / 2 + 20
        ]);


const path =
    d3.geoPath(
        projection
    );



/* ==========================================================
   SPHERE
========================================================== */

svg

    .append("path")

    .datum({
        type:
            "Sphere"
    })

    .attr(
        "class",
        "sphere"
    )

    .attr(
        "d",
        path
    );



/* ==========================================================
   GRATICULE
========================================================== */

const graticule =
    d3.geoGraticule10();


svg

    .append("path")

    .datum(
        graticule
    )

    .attr(
        "class",
        "graticule"
    )

    .attr(
        "d",
        path
    );



/* ==========================================================
   PACIFIC LABEL
========================================================== */

svg

    .append("text")

    .attr(
        "class",
        "ocean-title"
    )

    .attr(
        "x",
        width / 2
    )

    .attr(
        "y",
        height / 2 + 15
    )

    .attr(
        "text-anchor",
        "middle"
    )

    .text(
        "PACIFIC"
    );



/* ==========================================================
   MAP LAYERS
========================================================== */

const mapLayer =
    svg.append("g");


const markerLayer =
    svg.append("g");


const labelLayer =
    svg.append("g");



/* ==========================================================
   LOAD WORLD MAP
========================================================== */

d3.json(
    "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json"
)

.then(

    world => {


        const countries =

            topojson.feature(

                world,

                world.objects.countries

            );



        /* ----------------------------------------------
           COAST GLOW
        ---------------------------------------------- */

        mapLayer

            .append("path")

            .datum(
                countries
            )

            .attr(
                "class",
                "coast-glow"
            )

            .attr(
                "d",
                path
            );



        /* ----------------------------------------------
           LAND
        ---------------------------------------------- */

        mapLayer

            .selectAll(".land")

            .data(
                countries.features
            )

            .enter()

            .append("path")

            .attr(
                "class",
                "land"
            )

            .attr(
                "d",
                path
            );


        drawAttractions();

    }

)

.catch(

    error => {

        console.error(
            "World map failed to load:",
            error
        );


        drawAttractions();

    }

);



/* ==========================================================
   DRAW TOURISM LOCATIONS
========================================================== */

function drawAttractions() {


    attractions.forEach(

        d => {


            const coords =

                projection([
                    +d.Longitude,
                    +d.Latitude
                ]);


            d.x =
                coords[0];


            d.y =
                coords[1];

        }

    );



    /* ======================================================
       PULSE RINGS
    ====================================================== */

    const rings =

        markerLayer

            .selectAll(".marker-ring")

            .data(
                attractions
            )

            .enter()

            .append("circle")

            .attr(
                "class",
                "marker-ring"
            )

            .attr(
                "cx",
                d => d.x
            )

            .attr(
                "cy",
                d => d.y
            )

            .attr(
                "r",
                10
            );



    function animateRings() {


        rings

            .attr(
                "r",
                9
            )

            .attr(
                "opacity",
                0.38
            )

            .transition()

            .duration(
                2600
            )

            .ease(
                d3.easeCubicOut
            )

            .attr(
                "r",
                19
            )

            .attr(
                "opacity",
                0
            )

            .on(
                "end",
                animateRings
            );

    }


    animateRings();



    /* ======================================================
       HALO
    ====================================================== */

    markerLayer

        .selectAll(".marker-halo")

        .data(
            attractions
        )

        .enter()

        .append("circle")

        .attr(
            "class",
            "marker-halo"
        )

        .attr(
            "cx",
            d => d.x
        )

        .attr(
            "cy",
            d => d.y
        )

        .attr(
            "r",
            8
        );



    /* ======================================================
       MAIN MARKERS
    ====================================================== */

    const markers =

        markerLayer

            .selectAll(".marker")

            .data(
                attractions
            )

            .enter()

            .append("circle")

            .attr(
                "class",
                "marker"
            )

            .attr(
                "cx",
                d => d.x
            )

            .attr(
                "cy",
                d => d.y
            )

            .attr(
                "r",
                5
            );



    /* ======================================================
       HOVER
    ====================================================== */

    markers

        .on(

            "mouseenter",

            function(event, d) {


                d3.select(this)

                    .transition()

                    .duration(
                        160
                    )

                    .attr(
                        "r",
                        8
                    );


                showCard(d);

            }

        )


        .on(

            "mouseleave",

            function() {


                d3.select(this)

                    .transition()

                    .duration(
                        160
                    )

                    .attr(
                        "r",
                        5
                    );


                hideCard();

            }

        );



    /* ======================================================
       COUNTRY LABELS
    ====================================================== */

    labelLayer

        .selectAll(".country-label")

        .data(
            attractions
        )

        .enter()

        .append("text")

        .attr(
            "class",
            "country-label"
        )

        .attr(
            "x",
            d => d.x + 11
        )

        .attr(
            "y",
            d => d.y + 4
        )

        .text(
            d => d.Country
        );

}



/* ==========================================================
   POSTCARD CARD
========================================================== */

const attractionCard =
    document.getElementById(
        "attraction-card"
    );


const cardImage =
    document.getElementById(
        "card-image"
    );


const cardCountry =
    document.getElementById(
        "card-country"
    );


const cardTitle =
    document.getElementById(
        "card-title"
    );


const cardExperience =
    document.getElementById(
        "card-experience"
    );


const cardDescription =
    document.getElementById(
        "card-description"
    );



function showCard(d) {


    cardImage.src =
        d.Image;


    cardImage.alt =
        d.Attraction;


    cardCountry.textContent =
        d.Country;


    cardTitle.textContent =
        d.Attraction;


    cardExperience.textContent =
        d.Experience;


    cardDescription.textContent =
        d.Description;


    attractionCard

        .classList

        .add(
            "visible"
        );

}



function hideCard() {


    attractionCard

        .classList

        .remove(
            "visible"
        );

}


</script>


</body>

</html>
"""


