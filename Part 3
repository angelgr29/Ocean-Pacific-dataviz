const trendNote =
    document.getElementById(
        "trend-note"
    );


/* ==========================================================
   COLOR SCALE
========================================================== */

function createColorScale(
    indicator
) {


    const config =
        indicatorConfig[
            indicator
        ];


    /*
    ----------------------------------------------------------
    RED LIST = fixed 0 -> 1
    ----------------------------------------------------------
    */

    if (
        config.type ===
        "sequential"
    ) {


        return d3

            .scaleLinear()

            .domain([
                0,
                0.5,
                1
            ])

            .range([
                config.low,
                config.middle,
                config.high
            ])

            .clamp(
                true
            );

    }


    /*
    ----------------------------------------------------------
    ANOMALY INDICATORS

    Fixed domain across ALL years.
    Zero always remains neutral.
    ----------------------------------------------------------
    */

    const values =

        environmentData

            .filter(
                d =>
                    d.Indicator ===
                    indicator
            )

            .map(
                d =>
                    +d.Value
            )

            .filter(
                Number.isFinite
            );


    const minValue =

        Math.min(
            d3.min(values),
            0
        );


    const maxValue =

        Math.max(
            d3.max(values),
            0
        );


    return d3

        .scaleLinear()

        .domain([
            minValue,
            0,
            maxValue
        ])

        .range([
            config.low,
            config.neutral,
            config.high
        ])

        .clamp(
            true
        );

}


/* ==========================================================
   FORMAT VALUES
========================================================== */

function formatValue(
    indicator,
    value
) {


    if (
        value === undefined
        ||
        value === null
        ||
        Number.isNaN(+value)
    ) {

        return "—";

    }


    const config =
        indicatorConfig[
            indicator
        ];


    const number =
        +value;


    if (
        indicator ===
        "15.5.1 Red List Index"
    ) {

        return number.toFixed(
            config.decimals
        );

    }


    return (
        number > 0
        ? "+"
        : ""
    )
    +
    number.toFixed(
        config.decimals
    );

}


/* ==========================================================
   LEGEND
========================================================== */

function updateLegend() {


    const config =
        indicatorConfig[
            currentIndicator
        ];


    document
        .getElementById(
            "legend-title"
        )
        .textContent =
        config.label;


    /*
    Red List
    */

    if (
        config.type ===
        "sequential"
    ) {


        document
            .getElementById(
                "legend-gradient"
            )
            .style.background =
            `linear-gradient(
                to right,
                ${config.low},
                ${config.middle},
                ${config.high}
            )`;


        document
            .getElementById(
                "legend-min"
            )
            .textContent =
            "0";


        document
            .getElementById(
                "legend-mid"
            )
            .textContent =
            "0.5";


        document
            .getElementById(
                "legend-max"
            )
            .textContent =
            "1";


        return;

    }


    /*
    Anomalies
    */

    const values =

        environmentData

            .filter(
                d =>
                    d.Indicator ===
                    currentIndicator
            )

            .map(
                d =>
                    +d.Value
            )

            .filter(
                Number.isFinite
            );


    const minValue =

        Math.min(
            d3.min(values),
            0
        );


    const maxValue =

        Math.max(
            d3.max(values),
            0
        );


    document
        .getElementById(
            "legend-gradient"
        )
        .style.background =
        `linear-gradient(
            to right,
            ${config.low},
            ${config.neutral},
            ${config.high}
        )`;


    document
        .getElementById(
            "legend-min"
        )
        .textContent =
        minValue.toFixed(2);


    document
        .getElementById(
            "legend-mid"
        )
        .textContent =
        "0";


    document
        .getElementById(
            "legend-max"
        )
        .textContent =
        maxValue.toFixed(2);

}


/* ==========================================================
   UPDATE MAP
========================================================== */

function updateMap() {


    const year =
        availableYears[
            currentIndex
        ];


    yearDisplay.textContent =
        year;


    slider.value =
        currentIndex;


    /*
    Before 1980 the animation runs at 2× speed, so transitions
    are also shorter. From 1980 onward the animation slows down
    to make the sustained warming pattern easier to observe.
    */

    const transitionDuration =
        +year < 1980
        ? 80
        : 180;


    /*
    Show the contextual callout during the 1980s, only for the
    two temperature-anomaly indicators.
    */

    const isTemperatureIndicator =
        currentIndicator === "Surface Temperature anomalies"
        ||
        currentIndicator === "Sea Surface Temperature anomalies";


    const showTrendNote =
        isTemperatureIndicator
        &&
        +year >= 1980
        &&
        +year <= 1989;


    trendNote.classList.toggle(
        "visible",
        showTrendNote
    );


    /*
    ----------------------------------------------------------
    DATA FOR CURRENT YEAR
    ----------------------------------------------------------
    */

    const currentData =

        environmentData

            .filter(
                d =>
                    d.Indicator ===
                    currentIndicator

                    &&

                    +d.Year ===
                    +year
            );


    const valueMap =

        new Map(

            currentData.map(
                d => [
                    d.Country,
                    +d.Value
                ]
            )

        );


    const scale =
        createColorScale(
            currentIndicator
        );


    /*
    ----------------------------------------------------------
    UPDATE BIG DATA CIRCLES

    IMPORTANT:
    radius stays exactly 23.
    ----------------------------------------------------------
    */

    dataCircles

        .transition()

        .duration(
            350
        )

        .attr(
            "fill",
            d => {


                const value =
                    valueMap.get(
                        d.Country
                    );


                if (
                    value === undefined
                ) {

                    return "#DCE9DD";

                }


                return scale(
                    value
                );

            }
        )

        .attr(
            "stroke",
            d => {


                const value =
                    valueMap.get(
                        d.Country
                    );


                if (
                    value === undefined
                ) {

                    return "#AFC3B1";

                }


                return d3
                    .color(
                        scale(value)
                    )
                    .darker(
                        0.7
                    );

            }
        );


    /*
    ----------------------------------------------------------
    UPDATE OUTER STATIC RING COLOR
    ----------------------------------------------------------
    */

    circleRings

        .transition()

        .duration(
            transitionDuration
        )

        .attr(
            "stroke",
            d => {


                const value =
                    valueMap.get(
                        d.Country
                    );


                if (
                    value === undefined
                ) {

                    return "#BCCDBC";

                }


                return scale(
                    value
                );

            }
        );


    /* ======================================================
       REGIONAL AVERAGE
    ====================================================== */


    /*
    Restrict average to countries represented
    on this map.

    This avoids accidentally including a country
    that is in final_dataset but not displayed.
    */

    const displayedCountries =

        new Set(

            territories.map(
                d =>
                    d.Country
            )

        );


    const regionalValues =

        currentData

            .filter(
                d =>
                    displayedCountries.has(
                        d.Country
                    )
            )

            .map(
                d =>
                    +d.Value
            )

            .filter(
                Number.isFinite
            );


    const average =

        regionalValues.length > 0

        ? d3.mean(
            regionalValues
        )

        : null;


    regionalYear.textContent =
        `Year ${year}`;


    regionalValue.textContent =

        average === null

        ? "—"

        : formatValue(
            currentIndicator,
            average
        );


    const currentConfig =
        indicatorConfig[
            currentIndicator
        ];


    regionalIndicator.textContent =
        currentConfig.baseline
        ? `${currentConfig.label} · ${currentConfig.baseline}`
        : currentConfig.label;


    /*
    Optional:
    tint regional average number using the same scale.
    */

    regionalValue.style.color =

        average === null

        ? "#1B5E20"

        : d3
            .color(
                scale(average)
            )
            .darker(
                0.65
            );


    updateLegend();

}


/* ==========================================================
   LOAD INDICATOR
========================================================== */

function loadIndicator(
    indicator
) {


    currentIndicator =
        indicator;


    trendNote.classList.remove(
        "visible"
    );


    availableYears =

        Array.from(

            new Set(

                environmentData

                    .filter(
                        d =>
                            d.Indicator ===
                            currentIndicator
                    )

                    .map(
                        d =>
                            +d.Year
                    )

            )

        )

        .sort(
            (a,b) =>
                a-b
        );


    currentIndex =
        0;


    slider.min =
        0;


    slider.max =
        availableYears.length - 1;


    slider.step =
        1;


    slider.value =
        0;


    document
        .getElementById(
            "year-min"
        )
        .textContent =
        availableYears[0];


    document
        .getElementById(
            "year-max"
        )
        .textContent =
        availableYears[
            availableYears.length - 1
        ];


    stopAnimation();


    updateMap();

}


/* ==========================================================
   PLAY
========================================================== */

function playAnimation() {


    /*
    Restart from beginning if user already reached end.
    */

    if (
        currentIndex >=
        availableYears.length - 1
    ) {

        currentIndex =
            0;

        updateMap();

    }


    isPlaying =
        true;


    playButton.textContent =
        "❚❚";


    scheduleNextFrame();

}


/* ==========================================================
   VARIABLE PLAYBACK SPEED
========================================================== */

function scheduleNextFrame() {


    if (
        !isPlaying
    ) {

        return;

    }


    if (
        currentIndex >=
        availableYears.length - 1
    ) {

        stopAnimation();

        return;

    }


    const nextYear =
        availableYears[
            currentIndex + 1
        ];


    /*
    2× speed before 1980: 110 ms per year.
    Normal speed from 1980 onward: 220 ms per year.
    */

    const delay =
        +nextYear < 1980
        ? 110
        : 220;


    timer =
        setTimeout(

            () => {


                if (
                    !isPlaying
                ) {

                    return;

                }


                currentIndex++;


                updateMap();


                scheduleNextFrame();


            },

            delay

        );

}


/* ==========================================================
   STOP
========================================================== */

function stopAnimation() {


    if (
        timer
    ) {

        clearTimeout(
            timer
        );


        timer =
            null;

    }


    isPlaying =
        false;


    playButton.textContent =
        "▶";

}


/* ==========================================================
   PLAY BUTTON
========================================================== */

playButton

    .addEventListener(

        "click",

        () => {


            if (
                isPlaying
            ) {

                stopAnimation();

            }

            else {

                playAnimation();

            }

        }

    );


/* ==========================================================
   YEAR SLIDER
========================================================== */

slider

    .addEventListener(

        "input",

        event => {


            stopAnimation();


            currentIndex =
                +event.target.value;


            updateMap();

        }

    );


/* ==========================================================
   INDICATOR BUTTONS
========================================================== */

document

    .querySelectorAll(
        ".indicator-button"
    )

    .forEach(

        button => {


            button

                .addEventListener(

                    "click",

                    () => {


                        document

                            .querySelectorAll(
                                ".indicator-button"
                            )

                            .forEach(
                                x =>
                                    x.classList.remove(
                                        "active"
                                    )
                            );


                        button
                            .classList
                            .add(
                                "active"
                            );


                        loadIndicator(
                            button.dataset.indicator
                        );

                    }

                );

        }

    );


/* ==========================================================
   START
========================================================== */

loadIndicator(
    currentIndicator
);


