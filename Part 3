)


# ============================================================
# 2. PREPARE DATA
# ============================================================

env_data <- final_dataset %>%
  
  filter(
    Indicator %in% indicators
  ) %>%
  
  mutate(
    
    Year = as.numeric(Year),
    
    Value = as.numeric(Value),
    
    Country = case_when(
      
      Country %in% c(
        "Micronesia, Federated State of",
        "Micronesia (Federated States of)",
        "Federated States of Micronesia"
      ) ~ "Micronesia",
      
      TRUE ~ Country
