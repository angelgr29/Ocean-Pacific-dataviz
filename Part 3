let currentIndicator =
    "Surface Temperature anomalies";


let availableYears =
    [];


let currentIndex =
    0;


let timer =
    null;


let isPlaying =
    false;


/* ==========================================================
   CONTROLS
========================================================== */

const slider =
    document.getElementById(
        "year-slider"
    );


const playButton =
    document.getElementById(
        "play-button"
    );


