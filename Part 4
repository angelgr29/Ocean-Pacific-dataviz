<script>


/* ==========================================================
   SVG SETUP
========================================================== */

const svg =
    document.getElementById(
        "journey-svg"
    );


const journal =
    document.querySelector(
        ".journal"
    );


let width =
    journal.clientWidth;


const height =
    780;


svg.setAttribute(
    "viewBox",
    `0 0 ${width} ${height}`
);


/* ==========================================================
   HELPERS
========================================================== */

function svgElement(
    tag
) {

    return document.createElementNS(
        "http://www.w3.org/2000/svg",
        tag
    );

}


function addText(
    x,
    y,
    text,
    className
) {

    const element =
        svgElement(
            "text"
        );


    element.setAttribute(
        "x",
        x
    );


    element.setAttribute(
        "y",
        y
    );


    element.setAttribute(
        "class",
        className
    );


    element.textContent =
        text;


    svg.appendChild(
        element
    );


    return element;

}


/* ==========================================================
   JOURNEY NODES
========================================================== */

const nodes = [

    {

        x:
            width * 0.25,

        y:
            180,

        icon:
            "🌴",

        title:
            "Natural ecosystems",

        subtitle:
            "The attraction"

    },


    {

        x:
            width * 0.39,

        y:
            265,

        icon:
            "✈️",

        title:
            "Tourism",

        subtitle:
            "Visitors arrive"

    },


    {

        x:
            width * 0.53,

        y:
            180,

        icon:
            "💰",

        title:
            "Economic value",

        subtitle:
            "Income · jobs · growth"

    },


    {

        x:
            width * 0.67,

        y:
            265,

        icon:
            "🏨",

        title:
            "Tourism expansion",

        subtitle:
            "Infrastructure · activity"

    },


    {

        x:
            width * 0.79,

        y:
            180,

        icon:
            "⚠️",

        title:
            "Environmental pressure",

        subtitle:
            "The trade-off appears"

    }

];


/* ==========================================================
   MAIN ROUTE
========================================================== */

const mainRoute =
    svgElement(
        "path"
    );


mainRoute.setAttribute(
    "class",
    "route"
);


mainRoute.setAttribute(

    "d",

    `
    M
    ${nodes[0].x}
    ${nodes[0].y}

    C
    ${width * 0.31}
    ${110},

    ${width * 0.34}
    ${325},

    ${nodes[1].x}
    ${nodes[1].y}

    S
    ${width * 0.47}
    ${115},

    ${nodes[2].x}
    ${nodes[2].y}

    S
    ${width * 0.61}
    ${325},

    ${nodes[3].x}
    ${nodes[3].y}

    S
    ${width * 0.74}
    ${120},

    ${nodes[4].x}
    ${nodes[4].y}
    `

);


svg.appendChild(
    mainRoute
);


/* ==========================================================
   DRAW NODES
========================================================== */

nodes.forEach(

    node => {


        const circle =
            svgElement(
                "circle"
            );


        circle.setAttribute(
            "cx",
            node.x
        );


        circle.setAttribute(
            "cy",
            node.y
        );


        circle.setAttribute(
            "r",
            37
        );


        circle.setAttribute(
            "class",
            "node-main"
        );


        svg.appendChild(
            circle
        );


        addText(

            node.x,

            node.y + 1,

            node.icon,

            "node-icon"

        );


        addText(

            node.x,

            node.y + 59,

            node.title,

            "node-title"

        );


        addText(

            node.x,

            node.y + 76,

            node.subtitle,

            "node-subtitle"

        );

    }

);


/* ==========================================================
   CHECKPOINT TARGET
========================================================== */

const checkpointX =
    width * 0.50;


const checkpointY =
    415;


/* visual checkpoint circle */

const checkpointCircle =
    svgElement(
        "circle"
    );


checkpointCircle.setAttribute(
    "cx",
    checkpointX
);


checkpointCircle.setAttribute(
    "cy",
    checkpointY
);


checkpointCircle.setAttribute(
    "r",
    56
);


checkpointCircle.setAttribute(
    "fill",
    "#F5F1E4"
);


checkpointCircle.setAttribute(
    "stroke",
    "#6D8C70"
);


checkpointCircle.setAttribute(
    "stroke-width",
    1.7
);


svg.appendChild(
    checkpointCircle
);


/* ==========================================================
   ROUTE FROM PRESSURE TO CHECKPOINT
========================================================== */

const checkpointRoute =
    svgElement(
        "path"
    );


checkpointRoute.setAttribute(
    "class",
    "route"
);


checkpointRoute.setAttribute(

    "d",

    `
    M
    ${nodes[4].x}
    ${nodes[4].y + 38}

    C
    ${width * 0.76}
    ${320},

    ${width * 0.60}
    ${350},

    ${checkpointX}
    ${checkpointY - 55}
    `

);


svg.appendChild(
    checkpointRoute
);


/* ==========================================================
   SPLIT ROUTES
========================================================== */

const badRoute =
    svgElement(
        "path"
    );


badRoute.setAttribute(
    "class",
    "route route-bad"
);


badRoute.setAttribute(

    "d",

    `
    M
    ${checkpointX - 40}
    ${checkpointY + 40}

    C
    ${width * 0.43}
    ${520},

    ${width * 0.31}
    ${540},

    ${width * 0.20}
    ${610}
    `

);


svg.appendChild(
    badRoute
);



const goodRoute =
    svgElement(
        "path"
    );


goodRoute.setAttribute(
    "class",
    "route route-good"
);


goodRoute.setAttribute(

    "d",

    `
    M
    ${checkpointX + 40}
    ${checkpointY + 40}

    C
    ${width * 0.58}
    ${520},

    ${width * 0.69}
    ${540},

    ${width * 0.80}
    ${610}
    `

);


svg.appendChild(
    goodRoute
);


/* ==========================================================
   END ICONS
========================================================== */

addText(

    width * 0.20,

    610,

    "🪸",

    "node-icon"

);


addText(

    width * 0.80,

    610,

    "🌱",

    "node-icon"

);


/* ==========================================================
   COMPLETE INVISIBLE PLANE PATH
========================================================== */

const planePath =
    svgElement(
        "path"
    );


planePath.setAttribute(
    "fill",
    "none"
);


planePath.setAttribute(
    "stroke",
    "none"
);


planePath.setAttribute(

    "d",

    `
    M
    ${nodes[0].x}
    ${nodes[0].y}

    C
    ${width * 0.31}
    ${110},

    ${width * 0.34}
    ${325},

    ${nodes[1].x}
    ${nodes[1].y}

    S
    ${width * 0.47}
    ${115},

    ${nodes[2].x}
    ${nodes[2].y}

    S
    ${width * 0.61}
    ${325},

    ${nodes[3].x}
    ${nodes[3].y}

    S
    ${width * 0.74}
    ${120},

    ${nodes[4].x}
    ${nodes[4].y}

    C
    ${width * 0.76}
    ${320},

    ${width * 0.60}
    ${350},

    ${checkpointX}
    ${checkpointY}
    `

);


svg.appendChild(
    planePath
);


/* ==========================================================
   AIRPLANE
========================================================== */

const plane =
    svgElement(
        "text"
    );


plane.setAttribute(
    "class",
    "plane"
);


plane.textContent =
    "✈";


svg.appendChild(
    plane
);


/* ==========================================================
   PLANE ANIMATION
========================================================== */

const journeyLength =
    planePath.getTotalLength();


const animationDuration =
    9500;


let startTime =
    null;


let animationFrame =
    null;


function animatePlane(
    timestamp
) {


    if (
        startTime === null
    ) {

        startTime =
            timestamp;

    }


    const rawProgress =

        Math.min(

            (
                timestamp
                -
                startTime
            )

            /

            animationDuration,

            1

        );


    /* smooth movement */

    const progress =

        rawProgress < 0.5

        ?

        2
        *
        rawProgress
        *
        rawProgress

        :

        1
        -
        Math.pow(
            -2 * rawProgress + 2,
            2
        )
        /
        2;


    const distance =

        journeyLength
        *
        progress;


    const point =

        planePath
            .getPointAtLength(
                distance
            );


    const nextPoint =

        planePath
            .getPointAtLength(

                Math.min(
                    distance + 3,
                    journeyLength
                )

            );


    const angle =

        Math.atan2(

            nextPoint.y
            -
            point.y,

            nextPoint.x
            -
            point.x

        )

        *
        180
        /
        Math.PI;


    plane.setAttribute(
        "x",
        point.x
    );


    plane.setAttribute(
        "y",
        point.y - 13
    );


    plane.setAttribute(

        "transform",

        `
        rotate(
            ${angle},
            ${point.x},
            ${point.y - 13}
        )
        `

    );


    if (
        rawProgress < 1
    ) {

        animationFrame =

            requestAnimationFrame(
                animatePlane
            );

    }


    else {

        plane.setAttribute(
            "x",
            checkpointX
        );


        plane.setAttribute(
            "y",
            checkpointY - 69
        );


        plane.setAttribute(
            "transform",
            "rotate(0)"
        );

    }

}


/* ==========================================================
   CHOICE INTERACTION
========================================================== */

const badChoice =
    document.getElementById(
        "bad-choice"
    );


const goodChoice =
    document.getElementById(
        "good-choice"
    );


const finalMessage =
    document.getElementById(
        "final-message"
    );


function resetChoices() {


    badChoice
        .classList
        .remove(
            "active",
            "inactive"
        );


    goodChoice
        .classList
        .remove(
            "active",
            "inactive"
        );


    badRoute
        .classList
        .remove(
            "route-active",
            "route-dim"
        );


    goodRoute
        .classList
        .remove(
            "route-active",
            "route-dim"
        );


    finalMessage
        .classList
        .remove(
            "visible"
        );

}


function chooseBad() {


    resetChoices();


    badChoice
        .classList
        .add(
            "active"
        );


    goodChoice
        .classList
        .add(
            "inactive"
        );


    badRoute
        .classList
        .add(
            "route-active"
        );


    goodRoute
        .classList
        .add(
            "route-dim"
        );


    finalMessage
        .classList
        .add(
            "visible"
        );

}


function chooseGood() {


    resetChoices();


    goodChoice
        .classList
        .add(
            "active"
        );


    badChoice
        .classList
        .add(
            "inactive"
        );


    goodRoute
        .classList
        .add(
            "route-active"
        );


    badRoute
        .classList
        .add(
            "route-dim"
        );


    finalMessage
        .classList
        .add(
            "visible"
        );

}


badChoice
    .addEventListener(
        "click",
        chooseBad
    );


goodChoice
    .addEventListener(
        "click",
        chooseGood
    );


/* ==========================================================
   REPLAY
========================================================== */

const resetButton =
    document.getElementById(
        "reset-button"
    );


function replay() {


    if (
        animationFrame
    ) {

        cancelAnimationFrame(
            animationFrame
        );

    }


    resetChoices();


    startTime =
        null;


    requestAnimationFrame(
        animatePlane
    );

}


resetButton
    .addEventListener(
        "click",
        replay
    );


/* ==========================================================
   INITIAL RUN
========================================================== */

requestAnimationFrame(
    animatePlane
);


</script>


</body>

</html>
'


